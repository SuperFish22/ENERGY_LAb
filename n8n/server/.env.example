# ~/n8n/.env на сервере n8n (chmod 600). Создаётся из переменных старого контейнера, см. n8n/README.md.
N8N_HOST=energysup.duckdns.org
N8N_PROTOCOL=https
WEBHOOK_URL=https://energysup.duckdns.org/
N8N_PROXY_HOPS=1
# ВКонтакте (этап 2) — понадобится N8N_BLOCK_ENV_ACCESS_IN_NODE=false
# VK_GROUP_TOKEN=
# VK_SECRET=
# VK_CONFIRMATION=
