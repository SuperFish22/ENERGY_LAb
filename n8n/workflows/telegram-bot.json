{
  "id": "elabTelegramBot1",
  "name": "Energy Lab — Telegram-бот",
  "nodes": [
    {
      "id": "f4aa64b9-f16a-5889-987e-8414a53f72be",
      "name": "Telegram: входящие",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        300
      ],
      "parameters": {
        "updates": [
          "message",
          "callback_query"
        ],
        "additionalFields": {}
      },
      "credentials": {
        "telegramApi": {
          "id": "",
          "name": "Telegram ENERGY bot"
        }
      },
      "webhookId": "6af5b9c1-8423-5ed1-94a9-530727c92590"
    },
    {
      "id": "6c6403bf-ee9b-5925-affd-ba4dfdd39e69",
      "name": "Разбор команды",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "jsCode": "// Разбор входящего сообщения или нажатия кнопки → маршрут (номер выхода Switch)\nconst u = $json;\nconst msg = u.message || (u.callback_query && u.callback_query.message) || {};\nconst from = (u.message && u.message.from) || (u.callback_query && u.callback_query.from) || {};\nconst chatId = msg.chat ? msg.chat.id : from.id;\nconst who = { channel: 'telegram', user_id: String(from.id) };\nconst name = [from.first_name, from.last_name].filter(Boolean).join(' ');\nlet text = (u.message && u.message.text) || '';\nconst cb = u.callback_query ? u.callback_query.data : '';\nconst replyTo = u.message && u.message.reply_to_message ? (u.message.reply_to_message.text || '') : '';\nconst ROUTES = { start: 0, link: 1, unlink: 2, tasks: 3, task_status: 4, ask_menu: 5, ask: 6,\n                 discussions: 7, reply: 8, question: 9, afisha: 10, sos: 11, help: 12 };\nlet route = 'help', args = {};\nif (cb.startsWith('task:')) { const [, id, st] = cb.split(':'); route = 'task_status'; args = { id, status: st }; }\nelse if (cb.startsWith('ask:')) { route = 'help'; args = { hint: `Напишите одним сообщением:\\n/ask ${cb.slice(4)} Тема вопроса | подробности` }; }\nelse if (/^\\/start/.test(text)) route = 'start';\nelse if (/^\\/link\\s+\\d{6}/.test(text)) { route = 'link'; args = { code: text.match(/\\d{6}/)[0] }; }\nelse if (/^\\/unlink/.test(text)) route = 'unlink';\nelse if (/^\\/tasks|^мои задачи/i.test(text)) route = 'tasks';\nelse if (/^\\/ask\\s+[A-Z]+\\s+.+/.test(text)) {\n  const m = text.match(/^\\/ask\\s+([A-Z]+)\\s+(.+)$/s); const [title, ...rest] = m[2].split('|');\n  route = 'ask'; args = { department_code: m[1], title: title.trim().slice(0, 200), text: rest.join('|').trim() || null };\n}\nelse if (/^\\/ask|^вопрос отделу/i.test(text)) route = 'ask_menu';\nelse if (/^\\/discussions|^обсуждения/i.test(text)) route = 'discussions';\nelse if (/^\\/question\\s+.{3,}/s.test(text)) { route = 'question'; args = { text: text.replace(/^\\/question\\s+/, '') }; }\nelse if (/^\\/afisha|^афиша/i.test(text)) route = 'afisha';\nelse if (/^\\/sos|^sos/i.test(text)) { route = 'sos'; args = { text: text.replace(/^\\/?sos\\s*/i, '') || null }; }\nelse if (replyTo && /#обсуждение(\\d+)/.test(replyTo)) { route = 'reply'; args = { id: replyTo.match(/#обсуждение(\\d+)/)[1], text }; }\nreturn [{ json: { route: ROUTES[route], routeName: route, chatId, who, name, args } }];\n"
      }
    },
    {
      "id": "2ed9e00b-f07f-53f8-b6fc-2d62a7524208",
      "name": "Маршрут",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        440,
        300
      ],
      "parameters": {
        "mode": "expression",
        "numberOutputs": 13,
        "output": "={{ $json.route }}"
      }
    },
    {
      "id": "62397230-e691-564c-8a2e-6ac656ba2ffe",
      "name": "Текст ответа",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        300
      ],
      "parameters": {
        "jsCode": "// Ответ API → текст для пользователя\nconst p = $('Разбор команды').first().json;\nconst r = $json;\nconst err = r.detail ? (typeof r.detail === 'string' ? r.detail : 'Проверьте команду') : null;\nlet text = '', keyboard = null;\nswitch (p.routeName) {\n  case 'start': text = r.linked ? `Привет, ${r.full_name}! Центр управления на связи 🚀\\n/tasks — мои задачи\\n/ask — вопрос отделу\\n/discussions — обсуждения отдела\\n/afisha — ближайшие запуски\\n/sos — экстренная связь`\n                                : 'Привет! Это бот Energy Lab.\\nЧтобы видеть свои задачи, получите код в кабинете: Профиль и бот → «Получить код привязки», и отправьте сюда /link КОД.\\n/afisha — ближайшие запуски, /question — вопрос на доску.'; break;\n  case 'link': text = err || `Готово, ${r.full_name}. Аккаунт привязан, уведомления будут приходить сюда.`; break;\n  case 'unlink': text = err || 'Аккаунт отвязан. Уведомлений больше не будет.'; break;\n  case 'tasks':\n    if (err) { text = err; break; }\n    if (!r.tasks.length) { text = 'Открытых задач нет. Чистая орбита ✨'; break; }\n    text = 'Ваши задачи:\\n' + r.tasks.map((t, i) => `${i + 1}. ${t.title}${t.event ? ' — ' + t.event : ''}\\n   ${t.status_name}${t.due_date ? ', срок ' + t.due_date : ''}${t.overdue ? ' ⚠️ просрочено' : ''}`).join('\\n');\n    keyboard = { inline_keyboard: r.tasks.slice(0, 8).map((t, i) => [\n      { text: `${i + 1} → в работу`, callback_data: `task:${t.id}:in_progress` },\n      { text: `${i + 1} → готово`, callback_data: `task:${t.id}:done` }]) };\n    break;\n  case 'task_status': text = err || `Статус задачи: ${r.status_name}`; break;\n  case 'ask_menu':\n    text = 'Какому отделу вопрос?';\n    keyboard = { inline_keyboard: (r.departments || []).map(d => [{ text: d.name, callback_data: `ask:${d.code}` }]) }; break;\n  case 'ask': text = err || `Вопрос отправлен отделу. Эксперты получат уведомление.\\n${r.url}`; break;\n  case 'discussions':\n    text = err || (r.discussions.length ? 'Открытые обсуждения:\\n' + r.discussions.map(d => `#обсуждение${d.id} ${d.title} (${d.messages})\\n${d.url}`).join('\\n') + '\\n\\nЧтобы ответить — ответьте (reply) на это сообщение строкой с нужным #обсуждением.' : 'Открытых обсуждений нет.'); break;\n  case 'reply': text = err || 'Ответ добавлен в обсуждение.'; break;\n  case 'question': text = err || 'Вопрос отправлен модератору. Ответ придёт сюда.'; break;\n  case 'afisha': text = (r.events || []).length ? 'Ближайшие запуски:\\n' + r.events.map(e => `${e.date} — ${e.title} (${e.age}), ${e.price} ₽\\n${e.url}`).join('\\n') : 'Пока нет мероприятий в продаже.'; break;\n  case 'sos': text = r.reply || 'Если есть угроза жизни или здоровью — звоните 112.'; break;\n  default: text = p.args.hint || 'Команды: /tasks, /ask, /discussions, /afisha, /question ТЕКСТ, /sos, /link КОД';\n}\nreturn [{ json: { chatId: p.chatId, text, reply_markup: keyboard ? JSON.stringify(keyboard) : '' , sos: p.routeName === 'sos' ? r : null } }];\n"
      }
    },
