@startuml
!include _style.iuml
hide empty description
skinparam defaultFontSize 16
state "К выполнению" as T
state "В работе" as W
state "На проверке" as R
state "Выполнено" as D
[*] --> T : задача поставлена\n(уведомление исполнителю)
T --> W : исполнитель\nвзял в работу
W --> R : исполнитель сдал\n(задача не своя)
W --> D : исполнитель сдал\n(сам себе автор)
R --> D : автор принял
R --> W : автор вернул\nс комментарием
D --> W : переоткрыта
D --> [*]
legend bottom left
  <b>Обозначения</b>
  | закрашенный круг | начальное состояние |
  | круг в обводке | конечное состояние |
  | прямоугольник со скруглением | статус задачи (колонка доски) |
  | стрелка с подписью | переход и действие, которое его вызывает |
endlegend
@enduml
