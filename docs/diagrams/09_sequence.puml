@startuml
!include _style.iuml
skinparam defaultFontSize 14
autonumber
actor "Руководитель Lab" as R
participant "Веб-интерфейс" as UI
participant "Сервер приложения" as API
participant "Модуль оценивания\n(scoring, delphi, risk,\nforecast)" as F
database "БД" as DB
actor "Автор проекта" as A
R -> UI : «Рассчитать прогноз»
UI -> API : POST /cabinet/projects/{id}/forecast
API -> DB : выбрать оценки экспертов\nи риски блоков сценария
DB --> API : оценки, риски
API -> F : агрегировать оценки (веса cᵢ)
F --> API : Sⱼ, S, Vⱼ, W, Rⱼ, Q
alt W < 0,5 или max Vⱼ > 33 % и тур < 2
  API --> UI : предложить второй тур
else согласие достигнуто
end
API -> DB : выбрать проведённые мероприятия
DB --> API : история (гости, выручка,\nзатраты, рейтинг)
API -> F : найти k аналогов,\nрассчитать прогноз
F --> API : явка, продажи, бюджет, рейтинг
API -> F : применить правила рекомендации
F --> API : рекомендация и обоснования
API -> DB : сохранить прогноз,\nстатус «Оценён»
API --> UI : вкладка «Прогноз» раздела «Оценка»
UI --> R : прогноз, рекомендация, аналоги
R -> UI : решение и комментарий
UI -> API : POST /cabinet/projects/{id}/status
API -> DB : сохранить статус и уведомление
API ->> A : уведомление о решении\n(сайт, бот)

legend bottom left
  <b>Обозначения</b>
  | фигура человека | участник-пользователь |
  | прямоугольник | компонент системы |
  | цилиндр | база данных |
  | пунктирная вертикаль | линия жизни участника |
  | сплошная стрелка с номером | синхронный вызов |
  | пунктирная стрелка | ответ на вызов |
  | стрелка с открытым концом | асинхронное сообщение |
  | рамка alt | альтернатива: выполняется одна из ветвей |
endlegend
@enduml
