@startuml
!include _style.iuml
skinparam nodesep 35
skinparam ranksep 50
rectangle "1\nПредставить идею\nмероприятия" as B1
rectangle " & " as J1 #white
rectangle "3\nОбсудить сценарий\nи программу" as B2
rectangle "2\nОбсудить бюджет\nи площадку" as B3
rectangle " & " as J2 #white
rectangle "4\nПринять решение\n(руководители)" as B4
rectangle " X " as J3 #white
rectangle "7\nУтвердить\nк подготовке" as B5
rectangle "5\nОтправить автору\nна доработку" as B6
rectangle "6\nОтклонить\nидею" as B7
rectangle " X " as J4 #white
rectangle "8\nЗаписать итог\nв общий чат" as B8
B1 --> J1
J1 --> B2
J1 --> B3
B2 --> J2
B3 --> J2
J2 --> B4
B4 --> J3
J3 --> B5 : принять
J3 --> B6 : доработать
J3 --> B7 : отклонить
B5 --> J4
B6 --> J4
B7 --> J4
J4 --> B8
B6 ..> B1 : повторное\nпредставление

legend bottom left
  <b>Обозначения</b>
  |= Элемент |= Значение |
  | прямоугольник с номером | единица работы (действие) |
  | сплошная стрелка | отношение предшествования |
  | пунктирная стрелка | возврат на повтор |
  | перекрёсток <b>&</b> | соединение «И»: ветви выполняются параллельно |
  | перекрёсток <b>X</b> | соединение «исключающее ИЛИ»: выполняется одна ветвь |
endlegend
@enduml
