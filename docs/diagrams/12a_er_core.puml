@startuml
!include _style.iuml
skinparam defaultFontSize 11
hide circle
hide methods
skinparam linetype ortho

entity roles {
  *id : INT <<PK>>
  --
  code : VARCHAR(20) <<UK>>
  name : VARCHAR(100)
}
entity user_roles {
  *user_id : INT <<PK>> <<FK>>
  *role_id : INT <<PK>> <<FK>>
  --
}
entity users {
  *id : INT <<PK>>
  --
  full_name : VARCHAR(150)
  email : VARCHAR(120) <<UK>>
  phone : VARCHAR(20)
  password_hash : VARCHAR(255)
  telegram_id : VARCHAR(40) <<UK>>
  vk_id : VARCHAR(40) <<UK>>
  notify_channel : VARCHAR(10)
  is_active : BOOLEAN
  created_at : TIMESTAMP
}
entity departments {
  *id : INT <<PK>>
  --
  code : VARCHAR(20) <<UK>>
  name : VARCHAR(100)
  weight : FLOAT
}
entity experts {
  *id : INT <<PK>>
  --
  user_id : INT <<FK>>
  department_id : INT <<FK>>
  competence : FLOAT
  is_external : BOOLEAN
  organization : VARCHAR(150)
}
entity competence_history {
  *id : INT <<PK>>
  --
  expert_id : INT <<FK>>
  event_id : INT <<FK>>
  old_value : FLOAT
  new_value : FLOAT
  reason : VARCHAR(200)
  created_at : TIMESTAMP
}
entity event_formats {
  *id : INT <<PK>>
  --
  code : VARCHAR(10) <<UK>>
  name : VARCHAR(100)
  group_name : VARCHAR(100)
}
entity venues {
  *id : INT <<PK>>
  --
  name : VARCHAR(150)
  address : VARCHAR(255)
  capacity : INT
}
entity events {
  *id : INT <<PK>>
  --
  code : VARCHAR(20) <<UK>>
  title : VARCHAR(200)
  format_id : INT <<FK>>
  venue_id : INT <<FK>>
  author_id : INT <<FK>>
  status : VARCHAR(20)
  planned_date : DATE
  start_time : VARCHAR(5)
  slot_min : SMALLINT
  album_url : VARCHAR(500)
  age_rating : VARCHAR(4)
  ticket_price : NUMERIC(10, 2)
  planned_budget : NUMERIC(12, 2)
  capacity : INT
  target_audience : VARCHAR(255)
  description : TEXT
  timepad_event_id : VARCHAR(40)
  timepad_url : VARCHAR(255)
  created_at : TIMESTAMP
}
entity stations {
  *id : INT <<PK>>
  --
  event_id : INT <<FK>>
  order_no : SMALLINT
  title : VARCHAR(150)
  description : TEXT
  duration_min : SMALLINT
  cost : NUMERIC(10, 2)
  responsible_id : INT <<FK>>
  kind : VARCHAR(10)
  parent_id : INT <<FK>>
  rated : BOOLEAN
  fact_min : SMALLINT
  groups : SMALLINT
  transition_min : SMALLINT
}
entity criteria {
  *id : INT <<PK>>
  --
  department_id : INT <<FK>>
  code : VARCHAR(20) <<UK>>
  name : VARCHAR(150)
  weight : FLOAT
}
entity event_experts {
  *event_id : INT <<PK>> <<FK>>
  *expert_id : INT <<PK>> <<FK>>
  --
}
entity expertise_rounds {
  *id : INT <<PK>>
  --
  event_id : INT <<FK>>
  round_no : SMALLINT
  deadline : DATE
  opened_at : TIMESTAMP
  closed_at : TIMESTAMP
  kendall_w : FLOAT
}
entity evaluations {
  *id : INT <<PK>>
  --
  round_id : INT <<FK>>
  expert_id : INT <<FK>>
  criterion_id : INT <<FK>>
  station_id : INT <<FK>>
  score : SMALLINT
  comment : TEXT
  submitted : BOOLEAN
  updated_at : TIMESTAMP
}
entity risk_assessments {
  *id : INT <<PK>>
  --
  round_id : INT <<FK>>
  station_id : INT <<FK>>
  expert_id : INT <<FK>>
  probability : SMALLINT
  impact : SMALLINT
  comment : TEXT
}
entity forecasts {
  *id : INT <<PK>>
  --
  event_id : INT <<FK>>
  created_at : TIMESTAMP
  expert_score : FLOAT
  kendall_w : FLOAT
  attendance : INT
  attendance_low : INT
  attendance_high : INT
  tickets_sold : INT
  revenue : FLOAT
  budget : FLOAT
  avg_rating : FLOAT
  failure_risk : FLOAT
  recommendation : VARCHAR(40)
  reasons : JSON
  analogs : JSON
  params : JSON
}
entity decisions {
  *id : INT <<PK>>
  --
  event_id : INT <<FK>>
  decision : VARCHAR(20)
  comment : TEXT
  decided_by : INT <<FK>>
  created_at : TIMESTAMP
}
entity event_results {
  *id : INT <<PK>>
  --
  event_id : INT <<FK>>
  guests_count : INT
  tickets_sold : INT
  revenue : NUMERIC(12, 2)
  actual_cost : NUMERIC(12, 2)
  avg_rating : FLOAT
  lessons : TEXT
  reviewed_at : TIMESTAMP
}
entity tickets {
  *id : INT <<PK>>
  --
  event_id : INT <<FK>>
  external_order_id : VARCHAR(60) <<UK>>
  buyer_name : VARCHAR(150)
  email : VARCHAR(120)
  price : NUMERIC(10, 2)
  status : VARCHAR(20)
  purchased_at : TIMESTAMP
}
entity feedback {
  *id : INT <<PK>>
  --
  event_id : INT <<FK>>
  ticket_id : INT <<FK>>
  rating : SMALLINT
  nps : SMALLINT
  comment : TEXT
  is_anonymous : BOOLEAN
  excluded : BOOLEAN
  client_hash : VARCHAR(64)
  created_at : TIMESTAMP
}
entity feedback_stations {
  *feedback_id : INT <<PK>> <<FK>>
  *station_id : INT <<PK>> <<FK>>
  --
  rating : SMALLINT
}

criteria ||--o{ evaluations
departments ||--o{ criteria
departments ||--o{ experts
event_formats ||--o{ events
events ||--o{ competence_history
events ||--o{ decisions
events ||--o{ event_experts
events ||--o{ event_results
events ||--o{ expertise_rounds
events ||--o{ feedback
events ||--o{ forecasts
events ||--o{ stations
events ||--o{ tickets
expertise_rounds ||--o{ evaluations
expertise_rounds ||--o{ risk_assessments
experts ||--o{ competence_history
experts ||--o{ evaluations
experts ||--o{ event_experts
experts ||--o{ risk_assessments
feedback ||--o{ feedback_stations
roles ||--o{ user_roles
stations ||--o{ evaluations
stations ||--o{ feedback_stations
stations ||--o{ risk_assessments
tickets ||--o{ feedback
users ||--o{ decisions
users ||--o{ events
users ||--o{ experts
users ||--o{ stations
users ||--o{ user_roles
venues ||--o{ events
@enduml
