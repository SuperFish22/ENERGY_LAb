@startuml
!include _style.iuml
skinparam defaultFontSize 15
autonumber
actor "Гость" as G
participant "Бот\n(внешний сервер)" as B
participant "Сайт\n/api/bot" as S
database "БД" as D
actor "Оператор" as O
G -> B : «Можно вернуть билет?»
B -> S : POST /support
S -> D : диалог #N, сообщение
S -> D : уведомления операторам\n(сайт + очередь)
S --> B : new = true, подсказки FAQ
B --> G : «Передали оператору» +\nкнопки FAQ
B -> S : GET /notifications (раз в 15 с)
S --> B : «Поддержка, диалог N: текст гостя»
B --> O : сообщение в мессенджер
O -> B : ответ (reply) на сообщение
B -> S : POST /support/N/reply
S -> D : ответ, статус «Отвечено»,\nсообщение гостю в очередь
B -> S : GET /notifications
B --> G : «Поддержка Energy Lab: текст ответа»
legend bottom left
  <b>Обозначения</b>
  | фигура человека | участник-пользователь |
  | прямоугольник | компонент системы |
  | цилиндр | база данных |
  | пунктирная вертикаль | линия жизни участника |
  | сплошная стрелка с номером | запрос (вызов) |
  | пунктирная стрелка | ответ или доставка сообщения |
endlegend
@enduml
