@startuml
!include _style.iuml

skinparam rectangleRoundCorner 18
skinparam nodesep 30
skinparam ranksep 55
skinparam defaultFontSize 13
actor "Участник Lab" as U
actor "Эксперт" as E
actor "Руководитель" as R
actor "Гость /\nпокупатель" as G
rectangle "1\nВедение проекта\nи сценария" as P1
rectangle "2\nЭкспертная\nоценка" as P2
rectangle "3\nПрогноз,\nрекомендация" as P3
rectangle "4\nПродажа билетов\n(Timepad)" as P4
rectangle "5\nИтоговая оценка\n(разбор полёта)" as P5
rectangle "6\nЗадачи и\nуведомления" as P6
rectangle "7\nПоддержка\nи FAQ" as P7
database "D1 Проекты,\nблоки сценария,\nдокументы" as D1
database "D2 Туры, оценки,\nриски" as D2
database "D3 Прогнозы\nи решения" as D3
database "D4 Билеты,\nанкеты, факт" as D4
database "D5 Задачи,\nуведомления" as D5
database "D6 FAQ, диалоги\nподдержки" as D6
U --> P1 : концепция,\nсценарий, смета
P1 --> D1
D1 --> P2 : карточка проекта
E --> P2 : баллы, P и I
P2 --> D2
D2 --> P3 : S, W, R
D4 --> P3 : аналоги
P3 --> D3
D3 --> R : прогноз,\nрекомендация
R --> P1 : решение
G --> P4 : покупка, анкета
P4 --> D4
D4 --> P5 : гости, выручка,\nзатраты, анкеты
D3 --> P5 : прогноз
P5 --> D4
P5 --> R : точность прогноза,\nкомпетентность
R --> P6 : задача
P6 --> D5
D5 --> U : уведомление\n(сайт, Telegram)
G --> P7 : вопрос в боте
P7 --> D6
D6 --> G : ответ оператора,\nподсказка FAQ
@enduml
