@startuml
!include _style.iuml
hide circle
hide methods
skinparam linetype ortho
entity "Роль" as roles {
*Код роли
--
Наименование
}
entity "Пользователь" as users {
*Код пользователя
--
ФИО
E-mail
Телефон
мессенджер ID
}
entity "Отдел" as departments {
*Код отдела
--
Наименование
}
entity "Эксперт" as experts {
*Код эксперта
--
Коэффициент компетентности
Внешний (да/нет)
Организация
}
entity "Формат мероприятия" as formats {
*Код формата
--
Наименование
}
entity "Площадка" as venues {
*Код площадки
--
Название
Адрес
Вместимость
}
entity "Мероприятие" as events {
*Код мероприятия
--
Название
Статус
Плановая дата
Цена билета
Плановый бюджет
}
entity "Блок сценария" as stations {
*Код блока
