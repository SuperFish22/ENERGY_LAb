*Код документа
--
Название
Категория
Файл или ссылка
}
entity "Уведомление" as inbox {
*Код уведомления
--
Вид
Текст
Ссылка
Прочитано (да/нет)
}
entity "Заявка покупателя" as requests {
*Код заявки
--
Имя, контакт
Повод
Число гостей
Бюджет
Статус
}
entity "Вопрос FAQ" as faq {
*Код вопроса
--
Вопрос
Ответ
Тема
}
entity "Диалог поддержки" as chats {
*Код диалога
--
Канал
Собеседник
Статус
}
entity "Сообщение" as messages {
*Код сообщения
--
Направление
Текст
Время
}
roles }|--o{ users : роли пользователя
users ||--o| experts
departments ||--o{ experts
departments ||--o{ criteria
