--
Число гостей
Выручка
Факт. затраты
Средняя оценка
}
entity "Билет" as tickets {
*Код билета
--
Покупатель
Цена
Статус
}
entity "Отзыв" as feedback {
*Код отзыва
--
Оценка
Комментарий
}
entity "Задача" as tasks {
*Код задачи
--
Название
Статус
Приоритет
Срок
}
