# Скопируйте в .env и заполните. Файл .env не попадает в git.
SECRET_KEY=сгенерируйте: python -c "import secrets;print(secrets.token_urlsafe(48))"
BOT_API_TOKEN=длинный-случайный-токен-для-n8n
BASE_URL=https://lab.example.ru
ADMIN_EMAIL=lab@energy.ru
ADMIN_PASSWORD=смените-после-первого-входа
SECURE_COOKIES=1

POSTGRES_DB=energy_lab
POSTGRES_USER=energy_lab
POSTGRES_PASSWORD=сложный-пароль
DATABASE_URL=postgresql+psycopg://energy_lab:сложный-пароль@db:5432/energy_lab

# Образ из GitHub Container Registry (подставляется CI/CD)
IMAGE=ghcr.io/superfish22/energy-lab:latest
# Шифрование резервных копий (SYS-15): получатель GPG-ключа руководителей
BACKUP_GPG_RECIPIENT=lab-backup@energy.ru
