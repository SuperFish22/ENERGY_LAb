# Скопируйте в .env и заполните. Файл .env в git не попадает.
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Адрес сайта Energy Lab и тот же BOT_API_TOKEN, что в .env сайта
LAB_URL=https://lab.energy-academia.duckdns.org
BOT_API_TOKEN=
# ВКонтакте — необязательно: ключ доступа сообщества (сообщения, управление) и ID сообщества; Long Poll API включён
VK_GROUP_TOKEN=
VK_GROUP_ID=
# Как часто забирать уведомления с сайта, секунд
OUTBOX_EVERY_SEC=15
LOG_LEVEL=INFO
